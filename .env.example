# محلی. این فایل را کپی کن به .env؛ خود .env در git نادیده گرفته می‌شود.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-string

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# پایگاه داده: تا وقتی DATABASE_URL یا POSTGRESQL_DB_HOST خالی باشد،
# جنگو از SQLite در مسیر keshttamin/DB/db.sqlite3 استفاده می‌کند.
# SQLITE_PATH=

# PostgreSQL (لیارا یا سرور خودتان). فقط یکی از این دو روش را پر کنید.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# POSTGRESQL_DB_HOST=
# POSTGRESQL_DB_NAME=postgres
# POSTGRESQL_DB_USER=
# POSTGRESQL_DB_PASS=
# POSTGRESQL_DB_PORT=5432
# DB_CONN_MAX_AGE=60

# فقط بار اول، اگر این نام کاربری و موبایل وجود نداشته باشند، مدیر ارشد ساخته می‌شود.
# موبایل الزامی است چون مدل کاربر کشت‌تامین بدون آن ذخیره نمی‌شود.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=replace-me
# DJANGO_SUPERUSER_MOBILE=09120000000
# DJANGO_SUPERUSER_NAME=مدیر کشت‌تامین
# DJANGO_SUPERUSER_EMAIL=
